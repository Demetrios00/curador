# ---------------------------------------------------------------------------
# CuraDor Mobile — variáveis de ambiente públicas (Expo)
# Copie para ".env" na raiz da pasta mobile/.
#
# EXPO_PUBLIC_* não é segredo — é embutida no build por design do próprio
# Expo, e aqui contém apenas o endereço do backend, nunca uma chave de API.
# ---------------------------------------------------------------------------

# Android Emulator (Android Studio / AVD) — 10.0.2.2 é o alias que o
# próprio emulador usa para "localhost do computador host".
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3333

# iOS Simulator: troque a linha acima por
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3333

# Dispositivo físico (mesma rede Wi-Fi do computador rodando o backend):
# EXPO_PUBLIC_API_BASE_URL=http://SEU_IP_LOCAL:3333
