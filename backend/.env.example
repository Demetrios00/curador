# ---------------------------------------------------------------------------
# CuraDor Backend — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA faça commit do arquivo ".env" (apenas deste ".env.example").
# ---------------------------------------------------------------------------

# Usadas a partir do Passo 1 (Fase 1)
PORT=3333
NODE_ENV=development

# ---------------------------------------------------------------------------
# ATIVO — Firebase Admin SDK (endpoint de diagnóstico GET /api/_internal/firebase-check)
# Gere um service account em: Firebase Console > Configurações do Projeto >
# Contas de Serviço > Gerar nova chave privada (baixa um .json).
# Copie os campos abaixo do JSON baixado. FIREBASE_PRIVATE_KEY deve manter
# as aspas e os "\n" literais (o backend converte para quebras de linha reais).
# NUNCA faça commit do arquivo .json baixado nem do seu conteúdo aqui.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# ATIVO — Serviço de LLM (endpoint POST /api/chat)
# IMPORTANTE: gere uma chave NOVA em https://openrouter.ai/keys — a chave
# antiga usada no app mobile (openrouter.ts) deve ser revogada, pois ficou
# exposta no bundle do cliente. Sem esta variável, /api/chat responde 500
# com o código LLM_NOT_CONFIGURED (o servidor continua no ar normalmente).
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# Opcional: modelos de fallback (OpenRouter), separados por vírgula.
LLM_FALLBACK_MODELS=
# Opcional: limite de tempo por chamada (ms), tokens máximos e raciocínio estendido.
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=1024
LLM_DISABLE_REASONING=true

# ---------------------------------------------------------------------------
# OPCIONAL — Roteiro de carga controlado do Orquestrador (scripts/orchestratorLoadTest.ts)
# Evidência quantitativa para o TCC 2 (Seção 15 do projeto). NUNCA use a
# senha de uma conta de paciente real — crie uma conta de teste dedicada no
# Firebase Authentication deste projeto.
# ---------------------------------------------------------------------------
FIREBASE_WEB_API_KEY=
LOADTEST_PATIENT_EMAIL=
LOADTEST_PATIENT_PASSWORD=
