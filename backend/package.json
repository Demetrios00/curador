{
  "name": "curador-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend intermediário (Node.js + TypeScript) do CuraDor — intermedia app mobile, agentes especializados e camada MCP.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register/transpile-only --test tests/classifyAppointmentAction.test.ts tests/schedulingContinuation.test.ts",
    "seed:instructions": "ts-node --transpile-only scripts/seedInstructions.ts",
    "seed:test-appointments": "ts-node --transpile-only scripts/seedTestAppointments.ts",
    "seed:test-results": "ts-node --transpile-only scripts/seedTestResults.ts",
    "loadtest:orchestrator": "ts-node --transpile-only scripts/orchestratorLoadTest.ts",
    "llm:probe": "ts-node --transpile-only scripts/llmProbe.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
